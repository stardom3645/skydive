# Skydive config file

# list of analyzers used by analyzers and agents
analyzers:
  - ccvm:8082

agent:
  topology:
    probes:
      - socketinfo
      - lldp
      - libvirt

analyzer:
  topology:
    probes:
      - k8s
    k8s:
      config_file: "/usr/share/ablestack/ablestack-netdive/kubeconfigs/selected.kubeconfig"
      probes:
        - cluster
        - namespace
        - node
        - pod
        - service
        - deployment
        - daemonset
        - statefulset
        - ingress
        - networkpolicy

mold:
  vmNetworkMap:
    refreshInterval: 10
  console:
    enabled: true
  kubernetes:
    enforceSelection: true
    kubeconfigPath: "/usr/share/ablestack/ablestack-netdive/kubeconfigs/selected.kubeconfig"
    stateFile: "/usr/share/ablestack/ablestack-netdive/kubeconfigs/selected-cluster.json"
  api:
    endpoint: "http://ccvm:8080/client/api"
    apiKeyFile: "/usr/share/ablestack/ablestack-netdive/secrets/mold-api-key"
    secretKeyFile: "/usr/share/ablestack/ablestack-netdive/secrets/mold-secret-key"
  db:
    host: "127.0.0.1"
    port: 3306
    name: "cloud"
    user: "cloud"
    passwordFile: "/usr/share/ablestack/ablestack-netdive/secrets/mold-db-password"
