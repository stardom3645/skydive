# Skydive config file

# list of analyzers used by analyzers and agents
analyzers:
  - ccvm:8082

agent:
  topology:
    probes:
      - socketinfo
      - lldp
      - libvirt

mold:
  console:
    enabled: true
    apiEndpoint: "http://ccvm:8080/api/netdive/vmconsole"
  db:
    host: "127.0.0.1"
    port: 3306
    name: "cloud"
    user: "cloud"
    passwordFile: "/usr/share/ablestack/ablestack-netdive/secrets/mold-db-password"
